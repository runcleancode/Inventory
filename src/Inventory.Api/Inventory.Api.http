@baseUrl = http://localhost:5000

### Get all products (default page)
GET {{baseUrl}}/api/products
Accept: application/json

### Get all products (page 2, size 5)
GET {{baseUrl}}/api/products?page=2&pageSize=5
Accept: application/json

### Get all products (pageSize exceeds max, clamped to 100)
GET {{baseUrl}}/api/products?page=1&pageSize=99999
Accept: application/json

### Get all products (invalid page, clamped to 1)
GET {{baseUrl}}/api/products?page=-5&pageSize=10
Accept: application/json

### Get product by id (existing)
GET {{baseUrl}}/api/products/2
Accept: application/json

### Get product by id (not found)
GET {{baseUrl}}/api/products/99999
Accept: application/json

### Create product
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Create me"
}

### Create product - validation error (empty name)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": ""
}

### Create product - validation error (too long)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

### Update product
PUT {{baseUrl}}/api/products/16
Content-Type: application/json

{
  "name": "Updated"
}

### Update product - not found
PUT {{baseUrl}}/api/products/99999
Content-Type: application/json

{
  "name": "Nope"
}

### Update product - validation error
PUT {{baseUrl}}/api/products/1
Content-Type: application/json

{
  "name": ""
}

### Delete product
DELETE {{baseUrl}}/api/products/16

### Delete product - not found
DELETE {{baseUrl}}/api/products/99999

### Verify product is deleted
GET {{baseUrl}}/api/products/1

### Get all products (no filter)
GET {{baseUrl}}/api/products
Accept: application/json

### Filter by id
GET {{baseUrl}}/api/products?id=2
Accept: application/json

### Filter by name (contains, case-insensitive)
GET {{baseUrl}}/api/products?name=KaLem
Accept: application/json

### Filter by name + pagination
GET {{baseUrl}}/api/products?name=kalem&page=1&pageSize=5
Accept: application/json

### Filter that matches nothing
GET {{baseUrl}}/api/products?name=nothing
Accept: application/json

### Sort by id ascending (default)
GET {{baseUrl}}/api/products?sortBy=id&sortDir=asc
Accept: application/json

### Sort by id descending
GET {{baseUrl}}/api/products?sortBy=id&sortDir=desc
Accept: application/json

### Sort by name ascending
GET {{baseUrl}}/api/products?sortBy=name&sortDir=asc
Accept: application/json

### Sort by name descending
GET {{baseUrl}}/api/products?sortBy=name&sortDir=desc
Accept: application/json

### Sort by name descending with filter and pagination
GET {{baseUrl}}/api/products?name=kalem&sortBy=name&sortDir=desc&page=1&pageSize=5
Accept: application/json

### Invalid sortBy (falls back to id)
GET {{baseUrl}}/api/products?sortBy=password&sortDir=asc
Accept: application/json

### Invalid sortDir (should be 400)
GET {{baseUrl}}/api/products?sortBy=name&sortDir=invalid
Accept: application/json

### Search by keyword (q)
GET {{baseUrl}}/api/products?q=kalem
Accept: application/json

### Search + sort + pagination
GET {{baseUrl}}/api/products?q=kalem&sortBy=name&sortDir=asc&page=1&pageSize=5
Accept: application/json

### Search + name filter combined (both must match)
GET {{baseUrl}}/api/products?q=kalem&name=kirmizi
Accept: application/json

### Search that matches nothing
GET {{baseUrl}}/api/products?q=zzzzzzzzzz
Accept: application/json

### Search is case - insensitive
GET {{baseUrl}}/api/products?q=KALEM
Accept: application/json

### Invalid sortBy (should be 400)
GET {{baseUrl}}/api/products?sortBy=password
Accept: application/json

### Invalid page (should be 400)
GET {{baseUrl}}/api/products?page=0
Accept: application/json

### Invalid page size (too large, should be 400)
GET {{baseUrl}}/api/products?pageSize=99999
Accept: application/json

### Invalid page size (zero, should be 400)
GET {{baseUrl}}/api/products?pageSize=0
Accept: application/json

### Invalid id (negative, should be 400)
GET {{baseUrl}}/api/products?id=-5
Accept: application/json

### Search term too long (should be 400)
GET {{baseUrl}}/api/products?q=abcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyz
Accept: application/json

### Valid query (should be 200)
GET {{baseUrl}}/api/products?sortBy=name&sortDir=desc&page=1&pageSize=10&q=kalem
Accept:  application/json

### Empty sortBy (should be 200, defaults to id)
GET {{baseUrl}}/api/products?sortBy=
Accept: application/json

### Patch: update name only (should be 200)
PATCH {{baseUrl}}/api/products/2
Content-Type: application/merge-patch+json

{
    "name" : "Second New Value = Kursun Kalem"
}

### Patch: empty body (should be 200, no change)
PATCH {{baseUrl}}/api/products/2
Content-Type: application/merge-patch+json

{}

### Patch: null name (should be 400)
PATCH {{baseUrl}}/api/products/2
Content-Type: application/merge-patch+json

{
    "name" : null
}

### Patch: unknown field (should be 400)
PATCH {{baseUrl}}/api/products/2
Content-Type: application/merge-patch+json

{
    "price" : 10
}

### Patch: wrong content type (should be 415)
PATCH {{baseUrl}}/api/products/2
Content-Type: application/json

{
    "name" : "Test"
}

### Patch: body is array (should be 400)
PATCH {{baseUrl}}/api/products/2
Content-Type: application/merge-patch+json

[]

### Get by id as JSON
GET {{baseUrl}}/api/products/2
Accept: application/json

### Get by id as XML (should be XML)
GET {{baseUrl}}/api/products/2
Accept: application/xml

#### Get paged as XML (should be XML)
GET {{baseUrl}}/api/products?page=1&pageSize=5
Accept: application/xml

### Unspported Accept header (should be 406)
GET {{baseUrl}}/api/products/2
Accept: application/pdf

### Post with XML body (should be 415)
POST  {{baseUrl}}/api/products
Content-Type: application/xml

<ProductDto><Name>Test</Name></ProductDto>

### Post with JSON body (should be 201)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
    "name" : "26rd Product"
}

### No accept header → defaults to JSON (should be JSON)
GET {{baseUrl}}/api/products/2

### --- VERSIONING ---

### GET v1 by id (should be 200 JSON)
GET {{baseUrl}}/api/v1/products/2
Accept: application/json

### GET v1 by id as XML (should be 200 XML)
GET {{baseUrl}}/api/v1/products/2
Accept: application/xml

### GET v1 paged (should be 200 JSON)
GET {{baseUrl}}/api/v1/products?page=1&pageSize=5
Accept: application/json

### GET v1 paged as XML (should be 200 XML)
GET {{baseUrl}}/api/v1/products?page=1&pageSize=5
Accept: application/xml

### GET without version (should be 404)
GET {{baseUrl}}/api/products/2

### GET unsupported version (should be 404)
GET {{baseUrl}}/api/v2/products/2

### POST v1 (should be 201, Location: /api/v1/products/{id})
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "name": "Test Product"
}

### PUT v1 (should be 200)
PUT {{baseUrl}}/api/v1/products/2
Content-Type: application/json

{
  "name": "Updated Product"
}

### PATCH v1 (should be 200)
PATCH {{baseUrl}}/api/v1/products/25
Content-Type: application/merge-patch+json

{
  "name": "Patched Product"
}

### DELETE v1 (should be 204)
DELETE {{baseUrl}}/api/v1/products/25






