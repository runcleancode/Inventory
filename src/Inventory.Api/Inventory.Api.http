@baseUrl = http://localhost:5000

# ==========================================
# 1. PRODUCTS - RETRIEVAL (GET)
# ==========================================

### Get all products (Default pagination)
GET {{baseUrl}}/api/v1/products
Accept: application/json

### Get all products with custom pagination (Page 2, Size 5)
GET {{baseUrl}}/api/v1/products?page=2&pageSize=5
Accept: application/json

### Get all products - Page size exceeds maximum (Expected: Clamped to 100)
GET {{baseUrl}}/api/v1/products?page=1&pageSize=99999
Accept: application/json

### Get all products - Invalid page number (Expected: Clamped to 1)
GET {{baseUrl}}/api/v1/products?page=-5&pageSize=10
Accept: application/json

### Get product by ID (Existing)
GET {{baseUrl}}/api/v1/products/2
Accept: application/json

### Get product by ID - Not found (Expected: 404 Not Found)
GET {{baseUrl}}/api/v1/products/99999
Accept: application/json


# ==========================================
# 2. PRODUCTS - FILTERING, SORTING & SEARCH
# ==========================================

### Filter products by ID
GET {{baseUrl}}/api/v1/products?id=2
Accept: application/json

### Filter products by name (Contains, case-insensitive)
GET {{baseUrl}}/api/v1/products?name=KaLem
Accept: application/json

### Filter products by name combined with pagination
GET {{baseUrl}}/api/v1/products?name=kalem&page=1&pageSize=5
Accept: application/json

### Filter products - No matches found
GET {{baseUrl}}/api/v1/products?name=nothing
Accept: application/json

### Sort products by ID ascending (Default)
GET {{baseUrl}}/api/v1/products?sortBy=id&sortDir=asc
Accept: application/json

### Sort products by ID descending
GET {{baseUrl}}/api/v1/products?sortBy=id&sortDir=desc
Accept: application/json

### Sort products by name ascending
GET {{baseUrl}}/api/v1/products?sortBy=name&sortDir=asc
Accept: application/json

### Sort products by name descending
GET {{baseUrl}}/api/v1/products?sortBy=name&sortDir=desc
Accept: application/json

### Sort products by name descending with filter and pagination
GET {{baseUrl}}/api/v1/products?name=kalem&sortBy=name&sortDir=desc&page=1&pageSize=5
Accept: application/json

### Search products by keyword (q)
GET {{baseUrl}}/api/v1/products?q=kalem
Accept: application/json

### Search combined with sort and pagination
GET {{baseUrl}}/api/v1/products?q=kalem&sortBy=name&sortDir=asc&page=1&pageSize=5
Accept: application/json

### Search combined with name filter (Both must match)
GET {{baseUrl}}/api/v1/products?q=kalem&name=kirmizi
Accept: application/json

### Search products - Case-insensitive check
GET {{baseUrl}}/api/v1/products?q=KALEM
Accept: application/json

### Search products - No matches found
GET {{baseUrl}}/api/v1/products?q=zzzzzzzzzz
Accept: application/json

### Complex valid query combining search, sort, pagination (Expected: 200 OK)
GET {{baseUrl}}/api/v1/products?sortBy=name&sortDir=desc&page=1&pageSize=10&q=kalem
Accept: application/json

### Empty sortBy parameter (Expected: 200 OK, defaults to ID)
GET {{baseUrl}}/api/v1/products?sortBy=
Accept: application/json


# ==========================================
# 3. PRODUCTS - CREATION (POST)
# ==========================================

### Create product successfully
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "name": "New Product"
}

### Create product - Validation error: Empty name (Expected: 400 Bad Request)
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "name": ""
}

### Create product - Validation error: Name too long (Expected: 400 Bad Request)
POST {{baseUrl}}/api/v1/products
Content-Type: application/json

{
  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}


# ==========================================
# 4. PRODUCTS - FULL UPDATE (PUT)
# ==========================================

### Update product completely
PUT {{baseUrl}}/api/v1/products/16
Content-Type: application/json

{
  "name": "Updated Product"
}

### Update product - Not found (Expected: 404 Not Found)
PUT {{baseUrl}}/api/v1/products/99999
Content-Type: application/json

{
  "name": "Nope"
}

### Update product - Validation error: Empty name (Expected: 400 Bad Request)
PUT {{baseUrl}}/api/v1/products/1
Content-Type: application/json

{
  "name": ""
}


# ==========================================
# 5. PRODUCTS - PARTIAL UPDATE (PATCH)
# ==========================================

### Patch product - Update name only
PATCH {{baseUrl}}/api/v1/products/2
Content-Type: application/json

{
  "name": "Patched Name"
}

### Patch product - No fields provided (Expected: 200 OK, No-op)
PATCH {{baseUrl}}/api/v1/products/2
Content-Type: application/json

{}

### Patch product - Null name (Expected: 200 OK, No-op)
PATCH {{baseUrl}}/api/v1/products/2
Content-Type: application/json

{
  "name": null
}

### Patch product - Validation error: Empty name (Expected: 400 Bad Request)
PATCH {{baseUrl}}/api/v1/products/2
Content-Type: application/json

{
  "name": ""
}

### Patch product - Validation error: Name too long (Expected: 400 Bad Request)
PATCH {{baseUrl}}/api/v1/products/2
Content-Type: application/json

{
  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

### Patch product - Not found (Expected: 404 Not Found)
PATCH {{baseUrl}}/api/v1/products/99999
Content-Type: application/json

{
  "name": "Nope"
}


# ==========================================
# 6. PRODUCTS - DELETION (DELETE)
# ==========================================

### Delete product successfully
DELETE {{baseUrl}}/api/v1/products/16

### Delete product - Not found (Expected: 404 Not Found)
DELETE {{baseUrl}}/api/v1/products/99999

### Verify product deletion (Expected: 404 Not Found)
GET {{baseUrl}}/api/v1/products/1


# ==========================================
# 7. VALIDATION & ERROR HANDLING (400 Bad Request)
# ==========================================

### Invalid sortBy field (Expected: Falls back to ID or 400 depending on rules)
GET {{baseUrl}}/api/v1/products?sortBy=password
Accept: application/json

### Invalid sortDir parameter (Expected: 400 Bad Request)
GET {{baseUrl}}/api/v1/products?sortBy=name&sortDir=invalid
Accept: application/json

### Invalid page number (Expected: 400 Bad Request)
GET {{baseUrl}}/api/v1/products?page=0
Accept: application/json

### Invalid page size - Too large (Expected: 400 Bad Request)
GET {{baseUrl}}/api/v1/products?pageSize=99999
Accept: application/json

### Invalid page size - Zero (Expected: 400 Bad Request)
GET {{baseUrl}}/api/v1/products?pageSize=0
Accept: application/json

### Invalid ID - Negative value (Expected: 400 Bad Request)
GET {{baseUrl}}/api/v1/products?id=-5
Accept: application/json

### Search term too long (Expected: 400 Bad Request)
GET {{baseUrl}}/api/v1/products?q=abcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyzabcdefghijklmnoprstxvyz
Accept: application/json


