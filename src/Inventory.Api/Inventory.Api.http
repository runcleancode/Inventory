@baseUrl = http://localhost:5000

### Get all products (default page)
GET {{baseUrl}}/api/products
Accept: application/json

### Get all products (page 2, size 5)
GET {{baseUrl}}/api/products?page=2&pageSize=5
Accept: application/json

### Get all products (pageSize exceeds max, clamped to 100)
GET {{baseUrl}}/api/products?page=1&pageSize=99999
Accept: application/json

### Get all products (invalid page, clamped to 1)
GET {{baseUrl}}/api/products?page=-5&pageSize=10
Accept: application/json

### Get product by id (existing)
GET {{baseUrl}}/api/products/2
Accept: application/json

### Get product by id (not found)
GET {{baseUrl}}/api/products/99999
Accept: application/json

### Create product
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Create me"
}

### Create product - validation error (empty name)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": ""
}

### Create product - validation error (too long)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

### Update product
PUT {{baseUrl}}/api/products/16
Content-Type: application/json

{
  "name": "Updated"
}

### Update product - not found
PUT {{baseUrl}}/api/products/99999
Content-Type: application/json

{
  "name": "Nope"
}

### Update product - validation error
PUT {{baseUrl}}/api/products/1
Content-Type: application/json

{
  "name": ""
}

### Delete product
DELETE {{baseUrl}}/api/products/16

### Delete product - not found
DELETE {{baseUrl}}/api/products/99999

### Verify product is deleted
GET {{baseUrl}}/api/products/1

### Get all products (no filter)
GET {{baseUrl}}/api/products
Accept: application/json

### Filter by id
GET {{baseUrl}}/api/products?id=2
Accept: application/json

### Filter by name (contains, case-insensitive)
GET {{baseUrl}}/api/products?name=KaLem
Accept: application/json

### Filter by name + pagination
GET {{baseUrl}}/api/products?name=kalem&page=1&pageSize=5
Accept: application/json

### Filter that matches nothing
GET {{baseUrl}}/api/products?name=nothing
Accept: application/json

### Sort by id ascending (default)
GET {{baseUrl}}/api/products?sortBy=id&sortDir=asc
Accept: application/json

### Sort by id descending
GET {{baseUrl}}/api/products?sortBy=id&sortDir=desc
Accept: application/json

### Sort by name ascending
GET {{baseUrl}}/api/products?sortBy=name&sortDir=asc
Accept: application/json

### Sort by name descending
GET {{baseUrl}}/api/products?sortBy=name&sortDir=desc
Accept: application/json

### Sort by name descending with filter and pagination
GET {{baseUrl}}/api/products?name=kalem&sortBy=name&sortDir=desc&page=1&pageSize=5
Accept: application/json

### Invalid sortBy (falls back to id)
GET {{baseUrl}}/api/products?sortBy=password&sortDir=asc
Accept: application/json

### Invalid sortDir (should be 400)
GET {{baseUrl}}/api/products?sortBy=name&sortDir=invalid
Accept: application/json

### Search by keyword (q)
GET {{baseUrl}}/api/products?q=kalem
Accept: application/json

### Search + sort + pagination
GET {{baseUrl}}/api/products?q=kalem&sortBy=name&sortDir=asc&page=1&pageSize=5
Accept: application/json

### Search + name filter combined (both must match)
GET {{baseUrl}}/api/products?q=kalem&name=kirmizi
Accept: application/json

### Search that matches nothing
GET {{baseUrl}}/api/products?q=zzzzzzzzzz
Accept: application/json

### Search is case - insensitive
GET {{baseUrl}}/api/products?q=KALEM
Accept: application/json
